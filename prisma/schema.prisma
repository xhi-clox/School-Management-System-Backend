generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  role        String   @default("Student") // Default role
  name        String?
  phone       String?
  address     String?
  department  String?
  designation String?
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Two-factor authentication
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?   // TOTP base32 secret
  twoFactorBackupCodes String?   // JSON array of backup codes

  parent        Parent?
  notifications Notification[]
  passwordResetTokens PasswordResetToken[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  author    String   @default("Admin")
  role      String   @default("Admin")
  target    String   @default("All")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([target])
}

model Parent {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Student {
  id              String                  @id @default(cuid())
  name            String
  admissionNo     String                  @unique
  class           String
  section         String
  roll            Int
  gender          String
  bloodGroup      String?
  religion        String?
  banglaName      String?
  dob             DateTime?
  guardianPhone   String?
  guardianEmail   String?
  fatherName      String?
  motherName      String?
  phone           String?
  email           String?
  nationality     String?
  medicalNote     String?
  additionalNote  String?
  birthCertNo     String?
  siblingsCount   Int?
  address         String?
  academicYear    String?
  shift           String?
  avatar          String?
  status          String                  @default("pending_payment")
  admissionDate   DateTime                @default(now())
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  
  // Admission tracking (New Fee System)
  admissionStatus       String              @default("pending") // "pending" | "completed" | "exempted"
  admissionFeeRecordId  String?             // Link to admission FeeRecord once created
  
  fees            StudentFee[]
  attendance      Attendance[]
  results         Result[]
  examAttendances ExamAttendance[]
  invoices        Invoice[]
  assignments     StudentFeeAssignment[]
  sales           Sale[]
  guardian        Guardian?
  login           StudentLogin?
  parentId        String?
  parent          Parent?                 @relation(fields: [parentId], references: [id])
  academicHistory StudentAcademicRecord[]
  leaves          Leave[]
  
  // New Fee System Relations
  feeRecords      FeeRecord[]
  feeOverrides    StudentFeeOverride[]
}

model Guardian {
  id               String   @id @default(cuid())
  studentId        String   @unique
  fatherName       String?
  fatherPhone      String?
  fatherOccupation String?
  motherName       String?
  motherPhone      String?
  motherOccupation String?
  guardianName     String?
  guardianPhone    String?
  guardianRelation String?
  guardianAddress  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentLogin {
  id        String    @id @default(cuid())
  studentId String    @unique
  username  String    @unique
  password  String
  role      String    @default("Student")
  status    String    @default("Active")
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Two-factor authentication
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?   // TOTP base32 secret
  twoFactorBackupCodes String?   // JSON array of backup codes

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model TeacherLogin {
  id        String    @id @default(cuid())
  teacherId String    @unique
  username  String    @unique
  password  String
  role      String    @default("Teacher")
  status    String    @default("Active")
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Two-factor authentication
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?   // TOTP base32 secret
  twoFactorBackupCodes String?   // JSON array of backup codes

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model AdmissionPackage {
  id          String   @id @default(cuid())
  name        String
  session     String
  classId     String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class    SchoolClass        @relation(fields: [classId], references: [id])
  feeItems AdmissionFeeItem[]
}

model AdmissionFeeItem {
  id          String   @id @default(cuid())
  packageId   String
  name        String
  amount      Decimal
  isMandatory Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  package AdmissionPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model Invoice {
  id           String    @id @default(cuid())
  studentId    String
  type         String // 'admission', 'tuition', etc.
  totalAmount  Decimal
  paidAmount   Decimal   @default(0)
  status       String // 'unpaid', 'partial', 'paid'
  dueDate      DateTime?
  billingMonth String? // 'YYYY-MM', or 'YYYY-ADM' for an admission fee
  academicYear String? // '2026-27'
  invoiceNo    String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  // Category fee system bridge. Exactly one Invoice per FeeRecord, which is what
  // makes a generated/added FeeRecord collectable through the normal payment flow
  // (Payment.invoiceId is required, so an Invoice has to exist to take money).
  migrationFeeRecordId String?     @unique
  migrationFeeRecord   FeeRecord?  @relation(fields: [migrationFeeRecordId], references: [id], onDelete: Cascade)

  student  Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items    InvoiceItem[]
  payments Payment[]

  @@index([type, billingMonth])
  @@index([studentId, billingMonth])
}

model InvoiceItem {
  id        String   @id @default(cuid())
  invoiceId String
  name      String
  amount    Decimal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String    @id @default(cuid())
  invoiceId      String
  amount         Decimal
  method         String
  transactionRef String?
  receivedBy     String?
  status         String    @default("active") // 'active' | 'voided'
  paymentNo      String?   @unique
  voidedAt       DateTime?
  voidedBy       String?
  voidReason     String?
  refundedAt     DateTime?
  refundReason   String?
  // Supplied by the client so a retried POST /payments cannot create a second receipt.
  idempotencyKey String?   @unique
  date           DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  // New Fee System linkage (FeeRecord is the owning side of this one-to-many)
  feeRecordId    String?
  feeRecord      FeeRecord? @relation("FeeRecordPayments", fields: [feeRecordId], references: [id], onDelete: SetNull)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, status])
  @@index([feeRecordId])
}

model LedgerEntry {
  id               String   @id @default(cuid())
  type             String // 'income', 'expense'
  category         String
  amount           Decimal
  // Not unique: several ledger rows can legitimately point at one invoice, e.g. a
  // partial payment and later a second instalment. paymentId is the per-transaction
  // link. A voided payment keeps its original row with reversedAt set rather than
  // gaining a cancelling row, so income nets out without a phantom expense.
  referenceInvoice String?
  paymentId        String?
  studentId        String?
  
  // New Fee System linkage
  feeRecordId      String?  // Link to FeeRecord
  feeCategoryId    String?  // Store fee category id for reporting
  billingPeriod    String?  // Store billing period for reporting
  
  date             DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Set when a void/refund cancels this row out. A reversed row is retained for
  // audit but must be excluded from every income/expense/profit total, otherwise
  // voiding a payment would leave the original income counted in full.
  reversedAt       DateTime?

  feeRecord        FeeRecord? @relation(fields: [feeRecordId], references: [id], onDelete: SetNull)
  feeCategoryModel FeeCategory? @relation(fields: [feeCategoryId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([createdAt])
  @@index([type, category])
  @@index([reversedAt])
  @@index([referenceInvoice])
  @@index([feeRecordId])
  @@index([feeCategoryId, billingPeriod])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String?
  entityId  String?
  actor     String?
  reason    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model NumberSequence {
  id        String   @id @default(cuid())
  scope     String   @unique // e.g. 'invoice-2026-27'
  last      Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Product {
  id            String         @id @default(cuid())
  name          String
  category      String?
  purchasePrice Decimal
  sellingPrice  Decimal
  currentStock  Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  phone     String?
  address   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]
}

model Purchase {
  id           String         @id @default(cuid())
  supplierId   String?
  purchaseDate DateTime       @default(now())
  totalCost    Decimal        @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  supplier     Supplier?      @relation(fields: [supplierId], references: [id])
  items        PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Int
  price      Decimal
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
}

model Sale {
  id            String     @id @default(cuid())
  studentId     String?
  saleDate      DateTime   @default(now())
  totalAmount   Decimal    @default(0)
  paymentStatus String     @default("unpaid")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  student       Student?   @relation(fields: [studentId], references: [id])
  items         SaleItem[]
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  price     Decimal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
}

model Teacher {
  id            String                @id @default(cuid())
  name          String
  employeeId    String                @unique
  subject       String
  email         String                @unique
  phone         String
  avatar        String?
  status        String                @default("Active")
  designation   String                @default("Teacher")
  joiningDate   DateTime?
  salary        Decimal?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  salaries      TeacherSalary[]
  attendance    TeacherAttendance[]
  classes       SchoolClass[]
  login         TeacherLogin?
  permission    TeacherPermission?
  classSubjects ClassSubjectTeacher[]
}

model TeacherPermission {
  id                 String   @id @default(cuid())
  teacherId          String   @unique
  teacher            Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  attendanceMode     String   @default("assigned")
  attendanceClassIds String[]
  marksMode          String   @default("assigned")
  marksClassIds      String[]
  updatedAt          DateTime @updatedAt
}

model ClassSubjectTeacher {
  id        String   @id @default(cuid())
  teacherId String
  classId   String
  subjectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([teacherId])
}

model Staff {
  id          String        @id @default(cuid())
  name        String
  employeeId  String        @unique
  designation String
  department  String?
  email       String?       @unique
  phone       String
  avatar      String?
  status      String        @default("Active")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  salaries    StaffSalary[]
}

model StudentFee {
  id        String   @id @default(cuid())
  studentId String
  feeType   String
  amount    Decimal
  discount  Decimal  @default(0)
  status    String   @default("Due")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model TeacherSalary {
  id          String   @id @default(cuid())
  teacherId   String
  baseSalary  Decimal
  bonus       Decimal  @default(0)
  deductions  Decimal  @default(0)
  netSalary   Decimal
  paymentDate DateTime
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teacher     Teacher  @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
  @@index([status])
  @@index([paymentDate])
  @@index([createdAt])
}

model StaffSalary {
  id          String   @id @default(cuid())
  staffId     String
  baseSalary  Decimal
  bonus       Decimal  @default(0)
  deductions  Decimal  @default(0)
  netSalary   Decimal
  paymentDate DateTime
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  staff       Staff    @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@index([status])
  @@index([paymentDate])
  @@index([createdAt])
}

model SchoolExpense {
  id        String   @id @default(cuid())
  category  String
  amount    Decimal
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([date])
  @@index([createdAt])
}

// User-managed income/expense categories. Ledger and expense rows still store
// the category as free text (LedgerEntry.category / SchoolExpense.category), so
// renaming a category also rewrites matching rows to keep reports consistent.
model FinanceCategory {
  id          String   @id @default(cuid())
  type        String // 'income' | 'expense'
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([type, name])
  @@index([type, isActive])
}

model SchoolClass {
  id        String   @id @default(cuid())
  name      String
  section   String
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional profile shown on the class detail page. All nullable so existing
  // rows need no backfill and the migration stays purely additive.
  room      String?
  floor     String?
  shift     String?
  startTime String?
  endTime   String?
  weekDays  String?
  session   String?
  capacity  Int?

  packages         AdmissionPackage[]
  feeStructures    FeeStructure[]
  examSchedules    ExamSchedule[]
  classSubjects    ClassSubjectTeacher[]

  // New Fee System
  feeAssignments   FeeAssignment[]
}

model FeeStructure {
  id          String                 @id @default(cuid())
  name        String
  classId     String?
  amount      Decimal
  frequency   String                 @default("monthly")
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  class       SchoolClass?           @relation(fields: [classId], references: [id])
  assignments StudentFeeAssignment[]
}

model StudentFeeAssignment {
  id              String       @id @default(cuid())
  studentId       String
  feeStructureId  String
  discountPercent Float        @default(0)
  customAmount    Decimal?
  startMonth      Int
  startYear       Int
  endMonth        Int?
  endYear         Int?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure    FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@index([studentId, isActive])
}

model Subject {
  id              String                @id @default(cuid())
  name            String
  /// Bengali name, same convention as Student.banglaName. Used by the admit card
  /// generator's bilingual schedule toggle.
  banglaName      String?
  code            String                @unique
  type            String
  creditHours     Float                 @default(1)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  schedules       ExamSchedule[]
  classSubjects   ClassSubjectTeacher[]
  examAttendances ExamAttendance[]
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime
  status    String
  // Set when this row was written by leave synchronization (approved leave).
  // Lets sync run idempotently and lets cancellation restore/keep foreign rows intact.
  leaveId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  leave     Leave?   @relation(fields: [leaveId], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([date, status])
  @@index([leaveId])
}

model TeacherAttendance {
  id        String   @id @default(cuid())
  teacherId String
  date      DateTime
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teacher   Teacher  @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, date])
}

model ExamType {
  id               String          @id @default(cuid())
  name             String          @unique // e.g., 'Semester', 'CT', 'Midterm', 'Final'
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  exams            Exam[]
  gradingRules     GradingSystem[]
  gradingSchedules ExamSchedule[]
}

model Exam {
  id             String                @id @default(cuid())
  name           String
  typeId         String // Link to ExamType (required, no empty-string default)
  type           ExamType              @relation(fields: [typeId], references: [id])
  startDate      DateTime
  endDate        DateTime
  academicYear   String
  // Result lifecycle state: Draft | Verification | Finalized | Published
  status         String                @default("Draft")
  publishedAt    DateTime?
  publishedBy    String?
  // Weight used when ranking by 'Weighted Academic Score' (0 = excluded)
  weight         Float                 @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  results        Result[]
  schedules      ExamSchedule[]
  publish        ResultPublish?
  validationRuns ResultValidationRun[]
  attendances    ExamAttendance[]

  @@index([academicYear, status])
}

model ExamAttendance {
  id        String   @id @default(cuid())
  examId    String
  studentId String
  subjectId String
  date      DateTime
  status    String   @default("PRESENT") // PRESENT, ABSENT, LATE, EXCUSED

  // Optional: for EXCUSED status
  reason String?
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([examId, studentId, subjectId, date])
}

model Result {
  id        String @id @default(cuid())
  studentId String
  examId    String
  subjectId String

  // Component marks (dynamic based on exam schedule configuration)
  written   Float @default(0)
  mcq       Float @default(0)
  practical Float @default(0)

  totalMarks   Float   @default(0)
  grade        String? // LG (Letter Grade)
  gp           Float? // GP (Grade Point)
  highestMarks Float   @default(0)

  // Absence tracking
  isAbsent Boolean @default(false)

  // Result lifecycle state: Draft | Verification | Finalized | Published
  status     String    @default("Draft")
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam      Exam     @relation(fields: [examId], references: [id])

  @@unique([studentId, examId, subjectId])
  @@index([examId, studentId])
}

model ResultPublish {
  id           String   @id @default(cuid())
  examId       String
  rankBy       String   @default("GPA") // TotalMarks | Percentage | GPA | WeightedAcademicScore
  rankSnapshot Json? // Frozen per-class ranking [{ class, section, entries }]
  publishedBy  String?
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  exam         Exam     @relation(fields: [examId], references: [id])

  @@unique([examId])
}

model ResultValidationRun {
  id        String   @id @default(cuid())
  examId    String
  health    Float // 0-100 readiness percentage
  issues    Json // [{ type, message, detail? }]
  createdAt DateTime @default(now())
  exam      Exam     @relation(fields: [examId], references: [id])
}

model ExamSchedule {
  id        String   @id @default(cuid())
  examId    String
  classId   String?
  subjectId String
  date      DateTime
  startTime String
  endTime   String

  // Total marks configuration
  fullMarks Int?
  passMarks Int?

  // Component full marks (must sum to fullMarks)
  writtenFullMarks   Int? @default(0)
  mcqFullMarks       Int? @default(0)
  practicalFullMarks Int? @default(0)

  // Component pass marks (optional per-component thresholds)
  writtenPassMarks   Int? @default(0)
  mcqPassMarks       Int? @default(0)
  practicalPassMarks Int? @default(0)

  gradingTypeId String? // per-subject grading override (null = use Exam.typeId)
  // Frozen grading configuration snapshot at scheduling time (never changes after).
  // Contains the grading bands + template reference used for THIS schedule. Editing
  // the template later does NOT affect schedules that already have a snapshot.
  gradingSnapshot Json?
  roomNo         String?
  sortOrder      Int? // ordinal within a class/day for drag-rearrange
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  exam          Exam         @relation(fields: [examId], references: [id])
  subject       Subject      @relation(fields: [subjectId], references: [id])
  class         SchoolClass? @relation(fields: [classId], references: [id])
  gradingType   ExamType?    @relation(fields: [gradingTypeId], references: [id])

  @@unique([examId, subjectId, classId])
}

model ExamPreset {
  id               String            @id @default(cuid())
  name             String
  durationHours    Int?
  onePerDay        Boolean           @default(true)
  gapDays          Int? // global gap between consecutive exams
  gapAfterSubjects Json              @default("[]") // [{subjectId, gapDays}] special gaps
  excludedWeekdays Json              @default("[5,6]") // e.g. [5,6] = Fri/Sat
  defaultStartTime String?
  defaultEndTime   String?
  classes          ExamPresetClass[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model ExamPresetClass {
  id        String              @id @default(cuid())
  presetId  String
  className String // grade NAME only (not id) so presets are reusable across years
  section   String? // e.g. "Science" | "Commerce" | null = all sections of that grade
  subjects  ExamPresetSubject[]
  preset    ExamPreset          @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@unique([presetId, className, section])
}

model ExamPresetSubject {
  id            String @id @default(cuid())
  presetClassId String
  subjectId     String
  position      Int

  // Total marks configuration
  fullMarks Int?
  passMarks Int?

  // Component full marks (preset defaults)
  writtenFullMarks   Int?
  mcqFullMarks       Int?
  practicalFullMarks Int?

  // Component pass marks (preset defaults)
  writtenPassMarks   Int?
  mcqPassMarks       Int?
  practicalPassMarks Int?

  presetClass ExamPresetClass @relation(fields: [presetClassId], references: [id], onDelete: Cascade)
}

model GradingSystem {
  id String @id @default(cuid())

  // Template identification (independent of exam type)
  name        String? // "100 Marks Standard", "50 Marks CT", etc.
  description String? // Optional description of the grading template

  // Grading band configuration
  grade      String
  minPercent Float
  maxPercent Float
  gp         Float  @default(0) // Grade Point
  status     String // 'PASS' or 'FAIL'

  // Optional link to ExamType (for default suggestions, not required)
  examTypeId String? // Made nullable - templates are independent
  examType   ExamType? @relation(fields: [examTypeId], references: [id])

  // Component configuration: full marks + pass marks per component (absolute values).
  // When the scheduled subject's full marks match the template's full marks, the pass
  // marks apply directly; otherwise they scale proportionally.
  writtenPass   Float?
  mcqPass       Float?
  practicalPass Float?
  totalPass     Float?
  writtenFull   Float?
  mcqFull       Float?
  practicalFull Float?
  totalFull     Float?

  // Optional default pass percentage (e.g., 40% for general pass threshold)
  defaultPassPercent Float? @default(40)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Leave {
  id            String   @id @default(cuid())
  studentId     String
  // Who submitted: Student (own), Parent User (linked child), Admin/Teacher (on behalf).
  applicantId   String
  applicantName String?
  applicantRole String   @default("Admin") // Student | Parent | Admin | Teacher
  leaveType     String   @default("FULL_DAY") // FULL_DAY | HALF_DAY
  halfDaySession String? // FIRST | SECOND (half-day only)
  startDate     DateTime
  endDate       DateTime
  category      String   @default("Other") // Illness | Medical appointment | Family emergency | Personal reasons | Travel | Other
  reason        String
  contactInfo   String? // parent/guardian contact for this application
  remarks       String? // applicant's extra remarks
  attachments   String[] @default([]) // Cloudinary URLs
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  calendarDays  Int      @default(0) // inclusive requested calendar days
  workingDays   Int      @default(0) // school working days affected (holidays/weekly offs excluded)
  approvedById    String?
  approvedByName  String?
  approvedAt      DateTime?
  reviewRemarks   String? // approval remarks
  rejectedById    String?
  rejectedByName  String?
  rejectedAt      DateTime?
  rejectionReason String?
  cancelledAt       DateTime?
  cancelledByName   String?
  cancelRequested   Boolean @default(false) // applicant asked to cancel an APPROVED leave
  cancelRequestNote String?
  attendanceSyncedAt DateTime? // set once sync first succeeds
  syncSummary        Json? // last sync result { created, overridden, skippedPresent, halfDaySkipped, dates }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student    Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  activities LeaveActivity[]
  attendance Attendance[]

  @@index([status])
  @@index([studentId, status])
  @@index([startDate])
  @@index([endDate])
  @@index([createdAt])
}

// Per-leave audit trail (submission, approval, rejection, cancellation, sync).
model LeaveActivity {
  id        String   @id @default(cuid())
  leaveId   String
  action    String // SUBMITTED | APPROVED | REJECTED | CANCELLED | CANCEL_REQUESTED | MODIFIED | ATTENDANCE_SYNCED | REQUEST_INFO | CANCELLED_PENDING
  actorId   String?
  actorName String?
  actorRole String?
  details   Json?
  createdAt DateTime @default(now())
  leave     Leave    @relation(fields: [leaveId], references: [id], onDelete: Cascade)

  @@index([leaveId, createdAt])
}

// Institution-wide official holidays. Weekly closures are configured on Institute.weeklyOffDays.
model Holiday {
  id          String    @id @default(cuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime? // multi-day holiday when set (else single day)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startDate])
}

model Institute {
  id         String   @id @default(cuid())
  name       String   @default("NexGrad Institute")
  logo       String?
  headmasterSignature String?
  targetLine String?  @default("ESTD: 2012")
  schoolCode String?
  emisCode   String?
  phone      String?
  website    String?
  address    String?
  country    String?
  email      String   @unique
  currency   String   @default("USD")
  // Day of the month monthly invoices fall due (clamped to the month's last day).
  dueDay     Int      @default(10)
  // Weekly closure days used when computing school working days (leave system).
  // Configurable from Settings; empty array means every day is a working day.
  weeklyOffDays String[] @default(["Friday", "Saturday"])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeeParticular {
  id        String   @id @default(cuid())
  label     String
  amount    Decimal? // null for FIXED fields
  isFixed   Boolean  @default(false)
  target    String   @default("All Students")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentAcademicRecord {
  id           String    @id @default(cuid())
  studentId    String
  academicYear String
  class        String
  section      String?
  roll         Int?
  status       String // 'Promoted' | 'Graduated' | 'Retained'
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([academicYear])
}

model RoutineEntry {
  id        String   @id @default(cuid())
  classId   String
  section   String
  day       String // Saturday ... Thursday
  period    String // time slot id
  subject   String
  teacher   String?
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, section, day, period])
  @@index([classId, section])
}

model RoutinePeriod {
  id        String   @id @default(cuid())
  period    String
  timeRange String
  isBreak   Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// NEW FEE SYSTEM MODELS (Category-Driven Architecture)
// ============================================================================

model FeeCategory {
  id              String   @id @default(cuid())
  name            String   // "Monthly Tuition", "Transport", "Admission", etc.
  code            String   @unique // "TUITION", "TRANSPORT", "ADMISSION" (for deduplication)
  description     String?
  
  // Billing Configuration
  isRecurring     Boolean  @default(true) // Recurring (monthly, annual) vs. One-time
  frequency       String   @default("monthly") // "monthly", "annual", "term", "once"
  isGeneratable   Boolean  @default(true) // Can be bulk-generated via /fees/generate
  
  // Status
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  assignments     FeeAssignment[]
  records         FeeRecord[]
  overrides       StudentFeeOverride[]
  ledgerEntries   LedgerEntry[]
  
  @@index([code])
  @@index([isActive, isGeneratable])
}

model FeeAssignment {
  id              String   @id @default(cuid())
  categoryId      String
  classId         String
  amount          Decimal  // Default amount for this category in this class
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  category        FeeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  class           SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  records         FeeRecord[] // Fee records that used this assignment
  
  @@unique([categoryId, classId]) // One assignment per category per class
  @@index([categoryId])
  @@index([classId])
  @@index([isActive])
}

model FeeRecord {
  id              String   @id @default(cuid())
  studentId       String
  categoryId      String
  billingPeriod   String   // "2026-10" (YYYY-MM) or "2026-ADM" for admission
  
  // Amount Calculation
  assignmentAmount Decimal? // Original assigned amount (for audit)
  amount          Decimal   // Final charge (after discounts/overrides)
  
  // Discount Structure
  discountType    String?   // "percentage" | "fixed" | null
  discountValue   Decimal?  // 10 (for 10%) or 300 (for ৳300)
  discountAmount  Decimal   @default(0) // Calculated: finalAmount = amount - discount
  
  // Proration & Overrides
  prorationType   String?   // "admission_day" | "mid_semester" | null
  proratedDays    Int?      // Days charged for
  totalDays       Int?      // Days in period (for calculation)
  
  // Metadata
  notes           String?
  source          String    @default("manual") // "manual" | "bulk_generation" | "package"
  status          String    @default("due") // "due" | "partial" | "paid"
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  student         Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category        FeeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assignment      FeeAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  assignmentId    String?
  payments        Payment[] @relation("FeeRecordPayments")
  ledgerEntries   LedgerEntry[]
  invoice         Invoice?
  override        StudentFeeOverride? @relation("FeeRecordOverride", fields: [overrideId], references: [id], onDelete: SetNull)
  overrideId      String?
  // Immutable snapshot of why this record's amount differs from the assignment.
  overrideReason  String?
  
  @@unique([studentId, categoryId, billingPeriod]) // CRITICAL: Prevent duplicates
  @@index([studentId])
  @@index([categoryId])
  @@index([billingPeriod])
  @@index([status])
  @@index([source])
  @@index([createdAt])
}

model StudentFeeOverride {
  id              String   @id @default(cuid())
  studentId       String
  categoryId      String
  billingPeriod   String?  // "2026-10" or null = "applies to all periods for this category"
  
  // Override Values
  overrideAmount  Decimal? // Override the assignment amount; null = no amount override
  overrideDiscount Decimal? // Override the discount
  discountType    String?   // "percentage" | "fixed"
  isWaiver        Boolean  @default(false) // Explicit waiver; null amount alone no longer waives
  overrideReason  String   // "Scholarship", "Hardship", "Sibling discount", etc.
  
  // Audit
  approvedBy      String?  // Admin user ID who created override
  validFrom       DateTime @default(now())
  validTo         DateTime? // null = no end date
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  student         Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category        FeeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  records         FeeRecord[] @relation("FeeRecordOverride")

  @@index([studentId])
  @@index([categoryId])
  @@index([validFrom, validTo]) // Check if active
}

// Password reset tokens for forgot password flow
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}
