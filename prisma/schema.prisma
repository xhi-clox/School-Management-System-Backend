generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  role        String   @default("Student") // Default role
  name        String?
  phone       String?
  address     String?
  department  String?
  designation String?
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent        Parent?
  notifications Notification[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model Parent {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  students  Student[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id            String   @id @default(cuid())
  name          String
  admissionNo   String   @unique
  class         String
  section       String
  roll          Int
  gender        String
  bloodGroup    String?
  religion      String?
  banglaName    String?
  dob           DateTime?
  guardianPhone String?
  guardianEmail String?
  fatherName    String?
  motherName    String?
  phone         String?
  email         String?
  nationality   String?
  medicalNote   String?
  additionalNote String?
  birthCertNo   String?
  siblingsCount Int?
  address       String?
  academicYear  String?
  shift         String?
  avatar        String?
  status        String   @default("pending_payment")
  admissionDate DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  fees          StudentFee[]
  attendance    Attendance[]
  results       Result[]
  examAttendances ExamAttendance[]
  invoices      Invoice[]
  assignments   StudentFeeAssignment[]
  sales         Sale[]
  guardian      Guardian?
  login         StudentLogin?
  parentId      String?
  parent        Parent?  @relation(fields: [parentId], references: [id])
  academicHistory StudentAcademicRecord[]
}

model Guardian {
  id                String   @id @default(cuid())
  studentId         String   @unique
  fatherName        String?
  fatherPhone       String?
  fatherOccupation  String?
  motherName        String?
  motherPhone       String?
  motherOccupation  String?
  guardianName      String?
  guardianPhone     String?
  guardianRelation  String?
  guardianAddress   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentLogin {
  id        String   @id @default(cuid())
  studentId String   @unique
  username  String   @unique
  password  String
  role      String   @default("Student")
  status    String   @default("Active")
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model TeacherLogin {
  id        String   @id @default(cuid())
  teacherId String   @unique
  username  String   @unique
  password  String
  role      String   @default("Teacher")
  status    String   @default("Active")
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model AdmissionPackage {
  id          String   @id @default(cuid())
  name        String
  session     String
  classId     String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  class       SchoolClass @relation(fields: [classId], references: [id])
  feeItems    AdmissionFeeItem[]
}

model AdmissionFeeItem {
  id          String   @id @default(cuid())
  packageId   String
  name        String
  amount      Decimal
  isMandatory Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  package     AdmissionPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model Invoice {
  id           String   @id @default(cuid())
  studentId    String
  type         String   // 'admission', 'tuition', etc.
  totalAmount  Decimal
  paidAmount   Decimal  @default(0)
  status       String   // 'unpaid', 'partial', 'paid'
  dueDate      DateTime?
  billingMonth String?  // 'YYYY-MM'
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items        InvoiceItem[]
  payments     Payment[]
}

model InvoiceItem {
  id        String   @id @default(cuid())
  invoiceId String
  name      String
  amount    Decimal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String   @id @default(cuid())
  invoiceId      String
  amount         Decimal
  method         String
  transactionRef String?
  receivedBy     String?
  date           DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model LedgerEntry {
  id               String   @id @default(cuid())
  type             String   // 'income', 'expense'
  category         String
  amount           Decimal
  referenceInvoice String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Product {
  id             String   @id @default(cuid())
  name           String
  category       String?
  purchasePrice  Decimal
  sellingPrice   Decimal
  currentStock   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchases Purchase[]
}

model Purchase {
  id           String         @id @default(cuid())
  supplierId   String?
  purchaseDate DateTime       @default(now())
  totalCost    Decimal        @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  supplier     Supplier?      @relation(fields: [supplierId], references: [id])
  items        PurchaseItem[]
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  productId   String
  quantity    Int
  price       Decimal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
}

model Sale {
  id            String     @id @default(cuid())
  studentId     String?
  saleDate      DateTime   @default(now())
  totalAmount   Decimal    @default(0)
  paymentStatus String     @default("unpaid")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  student       Student?   @relation(fields: [studentId], references: [id])
  items         SaleItem[]
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  price     Decimal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
}

model Teacher {
  id         String   @id @default(cuid())
  name       String
  employeeId String   @unique
  subject    String
  email      String   @unique
  phone      String
  avatar     String?
  status     String   @default("Active")
  designation String  @default("Teacher")
  joiningDate DateTime?
  salary      Decimal?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  salaries   TeacherSalary[]
  attendance TeacherAttendance[]
  classes    SchoolClass[]
  login      TeacherLogin?
  permission TeacherPermission?
  classSubjects ClassSubjectTeacher[]
}

model TeacherPermission {
  id                 String   @id @default(cuid())
  teacherId          String   @unique
  teacher            Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  attendanceMode     String   @default("assigned")
  attendanceClassIds String[]
  marksMode          String   @default("assigned")
  marksClassIds      String[]
  updatedAt          DateTime @updatedAt
}

model ClassSubjectTeacher {
  id        String   @id @default(cuid())
  teacherId String
  classId   String
  subjectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher   Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class     SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([teacherId])
}

model Staff {
  id         String   @id @default(cuid())
  name       String
  employeeId String   @unique
  designation String
  department String?
  email      String?  @unique
  phone      String
  avatar     String?
  status     String   @default("Active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  salaries   StaffSalary[]
}

model StudentFee {
  id         String   @id @default(cuid())
  studentId  String
  feeType    String
  amount     Decimal
  discount   Decimal    @default(0)
  status     String   @default("Due")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model TeacherSalary {
  id          String   @id @default(cuid())
  teacherId   String
  baseSalary  Decimal
  bonus       Decimal    @default(0)
  deductions  Decimal    @default(0)
  netSalary   Decimal
  paymentDate DateTime
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
}

model StaffSalary {
  id          String   @id @default(cuid())
  staffId     String
  baseSalary  Decimal
  bonus       Decimal    @default(0)
  deductions  Decimal    @default(0)
  netSalary   Decimal
  paymentDate DateTime
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  staff       Staff    @relation(fields: [staffId], references: [id])
}

model SchoolExpense {
  id        String   @id @default(cuid())
  category  String
  amount    Decimal
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SchoolClass {
  id        String   @id @default(cuid())
  name      String
  section   String
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  packages  AdmissionPackage[]
  feeStructures FeeStructure[]
  examSchedules ExamSchedule[]
  classSubjects ClassSubjectTeacher[]
}

model FeeStructure {
  id         String      @id @default(cuid())
  name       String
  classId    String?
  amount     Decimal
  frequency  String      @default("monthly")
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  class      SchoolClass? @relation(fields: [classId], references: [id])
  assignments StudentFeeAssignment[]
}

model StudentFeeAssignment {
  id              String       @id @default(cuid())
  studentId       String
  feeStructureId  String
  discountPercent Float        @default(0)
  customAmount    Decimal?
  startMonth      Int
  startYear       Int
  endMonth        Int?
  endYear         Int?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure    FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@index([studentId, isActive])
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  type        String
  creditHours Float    @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  schedules ExamSchedule[]
  classSubjects ClassSubjectTeacher[]
  examAttendances ExamAttendance[]
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([date, status])
}

model TeacherAttendance {
  id        String   @id @default(cuid())
  teacherId String
  date      DateTime
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teacher   Teacher  @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, date])
}

model ExamType {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., 'Semester', 'CT', 'Midterm', 'Final'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  exams       Exam[]
  gradingRules GradingSystem[]
}

model Exam {
  id          String    @id @default(cuid())
  name        String
  typeId      String // Link to ExamType (required, no empty-string default)
  type        ExamType  @relation(fields: [typeId], references: [id])
  startDate   DateTime
  endDate     DateTime
  academicYear String
  // Result lifecycle state: Draft | Verification | Finalized | Published
  status      String    @default("Draft")
  publishedAt DateTime?
  publishedBy String?
  // Weight used when ranking by 'Weighted Academic Score' (0 = excluded)
  weight      Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  results       Result[]
  schedules     ExamSchedule[]
  publish        ResultPublish?
  validationRuns ResultValidationRun[]
  attendances   ExamAttendance[]

  @@index([academicYear, status])
}

model ExamAttendance {
  id          String    @id @default(cuid())
  examId      String
  studentId   String
  subjectId   String
  date        DateTime
  status      String    @default("PRESENT") // PRESENT, ABSENT, LATE, EXCUSED
  
  // Optional: for EXCUSED status
  reason      String?
  notes       String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject   @relation(fields: [subjectId], references: [id])

  @@unique([examId, studentId, subjectId, date])
}

model Result {
  id        String   @id @default(cuid())
  studentId String
  examId    String
  subjectId String
  
  // Broken down marks
  ct        Float    @default(0) // Class Test
  cwhw      Float    @default(0) // CW & HW
  dgc       Float    @default(0) // D & GC
  written   Float    @default(0)
  mcq       Float    @default(0)
  practical Float    @default(0)
  
  totalMarks   Float    @default(0)
  grade        String?  // LG (Letter Grade)
  gp           Float?   // GP (Grade Point)
  highestMarks Float    @default(0)

  // Result lifecycle state: Draft | Verification | Finalized | Published
  status       String   @default("Draft")
  verifiedAt   DateTime?

  createdAt    DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam      Exam     @relation(fields: [examId], references: [id])

  @@unique([studentId, examId, subjectId])
  @@index([examId, studentId])
}

model ResultPublish {
  id          String   @id @default(cuid())
  examId      String
  rankBy      String   @default("GPA") // TotalMarks | Percentage | GPA | WeightedAcademicScore
  rankSnapshot Json? // Frozen per-class ranking [{ class, section, entries }]
  publishedBy String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  exam        Exam     @relation(fields: [examId], references: [id])

  @@unique([examId])
}

model ResultValidationRun {
  id        String   @id @default(cuid())
  examId    String
  health    Float // 0-100 readiness percentage
  issues    Json // [{ type, message, detail? }]
  createdAt DateTime @default(now())
  exam      Exam     @relation(fields: [examId], references: [id])
}

model ExamSchedule {
  id        String   @id @default(cuid())
  examId    String
  classId   String?
  subjectId String
  date      DateTime
  startTime String
  endTime   String
  fullMarks Int?
  passMarks Int?
  roomNo    String?
  sortOrder Int?     // ordinal within a class/day for drag-rearrange
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  exam      Exam     @relation(fields: [examId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
  class     SchoolClass? @relation(fields: [classId], references: [id])

  @@unique([examId, subjectId, classId])
}

model ExamPreset {
  id                 String   @id @default(cuid())
  name               String
  durationHours      Int?
  onePerDay          Boolean  @default(true)
  gapDays            Int?                          // global gap between consecutive exams
  gapAfterSubjects   Json     @default("[]")       // [{subjectId, gapDays}] special gaps
  excludedWeekdays   Json     @default("[5,6]")    // e.g. [5,6] = Fri/Sat
  defaultStartTime   String?
  defaultEndTime     String?
  classes            ExamPresetClass[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ExamPresetClass {
  id           String   @id @default(cuid())
  presetId     String
  className    String   // grade NAME only (not id) so presets are reusable across years
  section      String?  // e.g. "Science" | "Commerce" | null = all sections of that grade
  subjects     ExamPresetSubject[]
  preset       ExamPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@unique([presetId, className, section])
}

model ExamPresetSubject {
  id            String  @id @default(cuid())
  presetClassId String
  subjectId     String
  position      Int
  fullMarks     Int?
  passMarks     Int?
  presetClass   ExamPresetClass @relation(fields: [presetClassId], references: [id], onDelete: Cascade)
}

model GradingSystem {
  id           String   @id @default(cuid())
  grade        String
  minPercent   Float
  maxPercent   Float
  gp           Float    @default(0) // Grade Point
  status       String   // 'PASS' or 'FAIL'
  
  examTypeId   String   // Link to ExamType (required, no empty-string default)
  examType     ExamType @relation(fields: [examTypeId], references: [id])
  
  writtenPass   Float?
  mcqPass       Float?
  practicalPass Float?
  totalPass     Float?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Institute {
  id          String   @id @default(cuid())
  name        String   @default("NexGrad Institute")
  logo        String?
  targetLine  String?  @default("Excellence in Education")
  phone       String?
  website     String?
  address     String?
  country     String?
  email       String   @unique
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FeeParticular {
  id        String   @id @default(cuid())
  label     String
  amount    Decimal?   // null for FIXED fields
  isFixed   Boolean  @default(false)
  target    String   @default("All Students")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentAcademicRecord {
  id           String   @id @default(cuid())
  studentId    String
  academicYear String
  class        String
  section      String?
  roll         Int?
  status       String   // 'Promoted' | 'Graduated' | 'Retained'
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime @default(now())

  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([academicYear])
}

model RoutineEntry {
  id        String   @id @default(cuid())
  classId   String
  section   String
  day       String   // Saturday ... Thursday
  period    String   // time slot id
  subject   String
  teacher   String?
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId, section])
  @@unique([classId, section, day, period])
}

model RoutinePeriod {
  id        String   @id @default(cuid())
  period    String
  timeRange String
  isBreak   Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
